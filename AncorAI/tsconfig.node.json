{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "./out/types-node"
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/compartilhado/**/*", "electron.vite.config.ts"]
}
